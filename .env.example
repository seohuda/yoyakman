# Discord 봇 토큰
# Discord Developer Portal > 봇 > Token에서 복사
DISCORD_TOKEN=여기에_디스코드_봇_토큰_입력

# Google Gemini API 키
# https://aistudio.google.com/app/apikey 에서 발급
GEMINI_API_KEY=여기에_제미나이_API_키_입력

# 선택 설정 (아래 값이 기본값, 시간 단위: 초)
# 기존 2.5 Flash 사용 이력이 없는 프로젝트는 README의 모델 지원 안내 참고
GEMINI_MODEL=gemini-2.5-flash
MAX_MESSAGES=300
MAX_HISTORY_MESSAGES=3000
COLLECTION_TIMEOUT=15
MAX_LOG_CHARS=200000
SUMMARY_TIMEOUT=120
MAX_CONCURRENT_SUMMARIES=2
# 최초 호출 포함, 최대 5까지 허용
API_MAX_ATTEMPTS=3
MAX_RESPONSE_MESSAGES=4
